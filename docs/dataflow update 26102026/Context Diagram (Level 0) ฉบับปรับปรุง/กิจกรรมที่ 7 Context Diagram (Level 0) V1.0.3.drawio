ometry"/></mxCell><mxCell id="L0-e84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.68679;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.37594;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c76" target="L0-c79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c85" value="วาระการประชุม&lt;br&gt;รายงานวินิจฉัยชี้มูล" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="7932.0" y="537.6" width="936.0" height="93.0" as="geometry"/></mxCell><mxCell id="L0-e86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.49624;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.74717;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c79" target="L0-c76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c87" value="มติที่ประชุมตามวาระ&lt;br&gt;คำสั่งคณะกรรมการ&lt;br&gt;รายงานวินิจฉัยชี้มูลที่ลงนามแล้ว" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="7932.0" y="690.6" width="936.0" height="135.5" as="geometry"/></mxCell><mxCell id="L0-c88" value="Data Flow Diagram Level 0 (Context Diagram) : Process 0 E-CMIS กิจกรรมที่ 7 (หน้า 4/6 : E6)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontColor=#000000;fontSize=46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="9620.0" y="0.0" width="1760.0" height="135.6" as="geometry"/></mxCell><mxCell id="L0-c89" value="0" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=TH Sarabun New;fontStyle=0;align=center;verticalAlign=top;startSize=43;collapsible=0;horizontal=1;swimlaneFillColor=#FFFFFF;fontSize=34;fontColor=#000000;childLayout=stackLayout;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=1;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="9620.0" y="185.6" width="420.0" height="587.5" as="geometry"/></mxCell><mxCell id="L0-c90" value="E-CMIS กิจกรรมที่ 7 ระบบบริหารจัดการกระบวนงานพิจารณาและดำเนินการตามมติคณะกรรมการ ป.ป.ท." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=TH Sarabun New;fontColor=#000000;fontStyle=0;spacing=6;fontSize=34;" vertex="1" parent="L0-c89"><mxGeometry x="0.0" y="43.0" width="420.0" height="544.5" as="geometry"/></mxCell><mxCell id="L0-c91" value="E6 กองบริหารคดี (กลุ่มงานกิจการคณะกรรมการ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=34;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="11000.0" y="185.6" width="380.0" height="587.5" as="geometry"/></mxCell><mxCell id="L0-e92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.35745;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.35745;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c89" target="L0-c91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c93" value="รายงานไต่สวนวินิจฉัยชี้มูล สำนวนกองปราบและเขตพื้นที่&lt;br&gt;รายงานที่ได้รับมอบหมาย&lt;br&gt;คำสั่งคณะกรรมการ&lt;br&gt;คำสั่งคณะกรรมการ [รอยืนยัน DQ2]" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="10052.0" y="207.6" width="936.0" height="178.0" as="geometry"/></mxCell><mxCell id="L0-e94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.42553;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.42553;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c91" target="L0-c89"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c95" value="ผลพิจารณาความซับซ้อนยุ่งยาก&lt;br&gt;ความเห็นเสนอ&lt;br&gt;ร่างหนังสือคำสั่งคณะกรรมการ&lt;br&gt;คำสั่งแต่งตั้งคณะอนุกรรมการไต่สวน/คณะพนักงานไต่สวน&lt;br&gt;รายงานการไต่สวนเพิ่มเติมตามมติคณะกรรมการ ป.ป.ท. [รอยืนยัน DQ7]&lt;br&gt;ร่างรายงานวินิจฉัยชี้มูล&lt;br&gt;ร่างหนังสือลงโทษทางวินัย" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="10052.0" y="445.6" width="936.0" height="305.5" as="geometry"/></mxCell><mxCell id="L0-c96" value="Data Flow Diagram Level 0 (Context Diagram) : Process 0 E-CMIS กิจกรรมที่ 7 (หน้า 5/6 : E7–E8)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontColor=#000000;fontSize=46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="11740.0" y="0.0" width="1760.0" height="135.6" as="geometry"/></mxCell><mxCell id="L0-c97" value="0" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=TH Sarabun New;fontStyle=0;align=center;verticalAlign=top;startSize=43;collapsible=0;horizontal=1;swimlaneFillColor=#FFFFFF;fontSize=34;fontColor=#000000;childLayout=stackLayout;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=1;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="11740.0" y="185.6" width="420.0" height="875.0" as="geometry"/></mxCell><mxCell id="L0-c98" value="E-CMIS กิจกรรมที่ 7 ระบบบริหารจัดการกระบวนงานพิจารณาและดำเนินการตามมติคณะกรรมการ ป.ป.ท." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=TH Sarabun New;fontColor=#000000;fontStyle=0;spacing=6;fontSize=34;" vertex="1" parent="L0-c97"><mxGeometry x="0.0" y="43.0" width="420.0" height="832.0" as="geometry"/></mxCell><mxCell id="L0-c99" value="E7 ผู้อำนวยการกองบริหารคดี (ผอ.กบค.)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=34;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="13120.0" y="185.6" width="380.0" height="332.5" as="geometry"/></mxCell><mxCell id="L0-c100" value="E8 หน่วยงานต้นเรื่อง/เจ้าของเรื่อง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=34;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="13120.0" y="558.1" width="380.0" height="502.5" as="geometry"/></mxCell><mxCell id="L0-e101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=
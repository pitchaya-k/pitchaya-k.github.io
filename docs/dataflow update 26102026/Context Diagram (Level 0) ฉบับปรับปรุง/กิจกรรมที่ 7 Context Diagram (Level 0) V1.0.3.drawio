ze=34;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="6760.0" y="185.6" width="380.0" height="417.5" as="geometry"/></mxCell><mxCell id="L0-e71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.40120;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.40120;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c68" target="L0-c70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c72" value="บันทึกกองปราบฯ เสนอประธานกรรมการ ป.ป.ท. [รอยืนยัน DQ1]&lt;br&gt;รายงานไต่สวนเบื้องต้น/รายการไต่สวนเพื่อวินิจฉัยชี้มูล&lt;br&gt;รายงานไต่สวนฯ/รายการมติเรื่องทั่วไป รอลงนามบรรจุวาระ" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="5812.0" y="207.6" width="936.0" height="135.5" as="geometry"/></mxCell><mxCell id="L0-e73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.49701;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.49701;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c70" target="L0-c68"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c74" value="ผลการลงนามในบันทึกกองปราบฯ [รอยืนยัน DQ1]&lt;br&gt;คำสั่งมอบหมายงาน&lt;br&gt;ผลพิจารณาความซับซ้อนยุ่งยากของสำนวนไต่สวนเพื่อชี้มูล&lt;br&gt;ผลการลงนามบรรจุวาระการประชุม" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="5812.0" y="403.1" width="936.0" height="178.0" as="geometry"/></mxCell><mxCell id="L0-c75" value="Data Flow Diagram Level 0 (Context Diagram) : Process 0 E-CMIS กิจกรรมที่ 7 (หน้า 3/6 : E4–E5)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontColor=#000000;fontSize=46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="7500.0" y="0.0" width="1760.0" height="135.6" as="geometry"/></mxCell><mxCell id="L0-c76" value="0" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=TH Sarabun New;fontStyle=0;align=center;verticalAlign=top;startSize=43;collapsible=0;horizontal=1;swimlaneFillColor=#FFFFFF;fontSize=34;fontColor=#000000;childLayout=stackLayout;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=1;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="7500.0" y="185.6" width="420.0" height="662.5" as="geometry"/></mxCell><mxCell id="L0-c77" value="E-CMIS กิจกรรมที่ 7 ระบบบริหารจัดการกระบวนงานพิจารณาและดำเนินการตามมติคณะกรรมการ ป.ป.ท." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=TH Sarabun New;fontColor=#000000;fontStyle=0;spacing=6;fontSize=34;" vertex="1" parent="L0-c76"><mxGeometry x="0.0" y="43.0" width="420.0" height="619.5" as="geometry"/></mxCell><mxCell id="L0-c78" value="E4 กองบริหารคดี (กลุ่มงานคำวินิจฉัยและมติคณะกรรมการ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=34;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="8880.0" y="185.6" width="380.0" height="290.0" as="geometry"/></mxCell><mxCell id="L0-c79" value="E5 คณะกรรมการ ป.ป.ท." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidt
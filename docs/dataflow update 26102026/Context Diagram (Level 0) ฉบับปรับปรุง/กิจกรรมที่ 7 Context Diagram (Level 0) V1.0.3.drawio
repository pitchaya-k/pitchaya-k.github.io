<mxfile host="app.diagrams.net" agent="E-CMIS DFD generator" version="24.7.17"><diagram id="L0" name="Context Diagram (Level 0)"><mxGraphModel dx="2000" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L0-c1" value="Data Flow Diagram Level 0 (Context Diagram) : Process 0 E-CMIS กิจกรรมที่ 7 ระบบบริหารจัดการกระบวนงานพิจารณาและดำเนินการตามมติคณะกรรมการ ป.ป.ท." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=TH Sarabun New;fontColor=#000000;fontSize=46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2900.0" height="135.6" as="geometry"/></mxCell><mxCell id="L0-c2" value="0" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=TH Sarabun New;fontStyle=0;align=center;verticalAlign=top;startSize=43;collapsible=0;horizontal=1;swimlaneFillColor=#FFFFFF;fontSize=30;fontColor=#000000;childLayout=stackLayout;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=1;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="1230.0" y="185.6" width="440.0" height="2270.0" as="geometry"/></mxCell><mxCell id="L0-c3" value="E-CMIS กิจกรรมที่ 7 ระบบบริหารจัดการกระบวนงานพิจารณาและดำเนินการตามมติคณะกรรมการ ป.ป.ท." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=TH Sarabun New;fontColor=#000000;fontStyle=0;spacing=6;fontSize=30;" vertex="1" parent="L0-c2"><mxGeometry x="0.0" y="43.0" width="440.0" height="2227.0" as="geometry"/></mxCell><mxCell id="L0-c4" value="E1 เลขาธิการคณะกรรมการ ป.ป.ท.&lt;br&gt;(หรือรองเลขาฯ ปฏิบัติหน้าที่แทน)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0.0" y="185.6" width="330.0" height="345.0" as="geometry"/></mxCell><mxCell id="L0-c5" value="E2 คณะอนุกรรมการสนับสนุนเลขาธิการฯ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0.0" y="570.6" width="330.0" height="232.5" as="geometry"/></mxCell><mxCell id="L0-c6" value="E3 ประธานกรรมการ ป.ป.ท." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0.0" y="843.1" width="330.0" height="382.5" as="geometry"/></mxCell><mxCell id="L0-c7" value="E4 กองบริหารคดี (กลุ่มงานคำวินิจฉัยและมติคณะกรรมการ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0.0" y="1265.6" width="330.0" height="270.0" as="geometry"/></mxCell><mxCell id="L0-c8" value="E5 คณะกรรมการ ป.ป.ท." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0.0" y="1575.6" width="330.0" height="307.5" as="geometry"/></mxCell><mxCell id="L0-c9" value="E6 กองบริหารคดี (กลุ่มงานกิจการคณะกรรมการ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0.0" y="1923.1" width="330.0" height="532.5" as="geometry"/></mxCell><mxCell id="L0-c10" value="E7 ผู้อำนวยการกองบริหารคดี (ผอ.กบค.)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2570.0" y="645.6" width="330.0" height="307.5" as="geometry"/></mxCell><mxCell id="L0-c11" value="E8 หน่วยงานต้นเรื่อง/เจ้าของเรื่อง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2570.0" y="993.1" width="330.0" height="457.5" as="geometry"/></mxCell><mxCell id="L0-c12" value="E9 กองบริหารคดี (กลุ่มงานบริหารคดีและบริหารทั่วไป)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2570.0" y="1490.6" width="330.0" height="232.5" as="geometry"/></mxCell><mxCell id="L0-c13" value="E10 คณะอนุกรรมการกลั่นกรองเรื่องไต่สวนข้อเท็จจริง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=TH Sarabun New;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2570.0" y="1763.1" width="330.0" height="232.5" as="geometry"/></mxCell><mxCell id="L0-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.44203;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.06718;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c4" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c15" value="ความเห็น ข้อสั่งการ และผลการลงนามในรายงานไต่สวนฯ&lt;br&gt;คำสั่งส่งกลับสำนวนเร่งด่วนที่ไม่มีใบบันทึกนำด่วน&lt;br&gt;คำสั่งมอบหมายสำนวนที่มีประเด็นซับซ้อนยุ่งยาก" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="207.6" width="876.0" height="120.5" as="geometry"/></mxCell><mxCell id="L0-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.08480;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.55797;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c17" value="ข้อมูลสำนวนไต่สวนฯ และเอกสารประกอบการพิจารณา&lt;br&gt;สำนวนที่ผ่านการกลั่นกรองพร้อมมติอนุกรรมการสนับสนุนเลขาธิการฯ&lt;br&gt;ผลการสืบค้นรายการไต่สวน" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="388.1" width="876.0" height="120.5" as="geometry"/></mxCell><mxCell id="L0-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.33333;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.20374;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c5" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c19" value="มติอนุกรรมการสนับสนุนเลขาธิการฯ (ผลการกลั่นกรองสำนวนที่ซับซ้อนยุ่งยาก)" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="592.6" width="876.0" height="45.5" as="geometry"/></mxCell><mxCell id="L0-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.22137;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.50538;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c21" value="รายงานไต่สวนฯ ที่มีประเด็นซับซ้อนยุ่งยาก&lt;br&gt;ผลการสืบค้นรายการไต่สวน" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="698.1" width="876.0" height="83.0" as="geometry"/></mxCell><mxCell id="L0-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.49673;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.37335;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c6" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c23" value="ผลการลงนามในบันทึกกองปราบฯ [รอยืนยัน DQ1]&lt;br&gt;คำสั่งมอบหมายงาน&lt;br&gt;ผลพิจารณาความซับซ้อนยุ่งยากของสำนวนไต่สวนเพื่อชี้มูล&lt;br&gt;ผลการลงนามบรรจุวาระการประชุม" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="865.1" width="876.0" height="158.0" as="geometry"/></mxCell><mxCell id="L0-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.39097;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.60131;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c25" value="บันทึกกองปราบฯ เสนอประธานกรรมการ ป.ป.ท. [รอยืนยัน DQ1]&lt;br&gt;รายงานไต่สวนเบื้องต้น/รายการไต่สวนเพื่อวินิจฉัยชี้มูล&lt;br&gt;รายงานไต่สวนฯ/รายการมติเรื่องทั่วไป รอลงนามบรรจุวาระ" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="1083.1" width="876.0" height="120.5" as="geometry"/></mxCell><mxCell id="L0-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.42593;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.52643;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c7" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c27" value="ระเบียบวาระการประชุมและหนังสือเชิญประชุม&lt;br&gt;ใบมติและรายงานมติคณะกรรมการ" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="1287.6" width="876.0" height="83.0" as="geometry"/></mxCell><mxCell id="L0-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.54405;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.57407;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c29" value="คำสั่งบรรจุวาระการประชุม&lt;br&gt;มติคณะกรรมการ" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="1430.6" width="876.0" height="83.0" as="geometry"/></mxCell><mxCell id="L0-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.49593;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.67952;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c8" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c31" value="มติที่ประชุมตามวาระ&lt;br&gt;คำสั่งคณะกรรมการ&lt;br&gt;รายงานวินิจฉัยชี้มูลที่ลงนามแล้ว" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="1597.6" width="876.0" height="120.5" as="geometry"/></mxCell><mxCell id="L0-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.69714;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.62602;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c33" value="วาระการประชุม&lt;br&gt;รายงานวินิจฉัยชี้มูล" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="1778.1" width="876.0" height="83.0" as="geometry"/></mxCell><mxCell id="L0-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.56808;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.89868;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c9" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c35" value="ผลพิจารณาความซับซ้อนยุ่งยาก&lt;br&gt;ความเห็นเสนอ&lt;br&gt;ร่างหนังสือคำสั่งคณะกรรมการ&lt;br&gt;คำสั่งแต่งตั้งคณะอนุกรรมการไต่สวน/คณะพนักงานไต่สวน&lt;br&gt;รายงานการไต่สวนเพิ่มเติมตามมติคณะกรรมการ ป.ป.ท. [รอยืนยัน DQ7]&lt;br&gt;ร่างรายงานวินิจฉัยชี้มูล&lt;br&gt;ร่างหนังสือลงโทษทางวินัย" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="1945.1" width="876.0" height="270.5" as="geometry"/></mxCell><mxCell id="L0-e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.91630;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.64319;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c37" value="รายงานไต่สวนวินิจฉัยชี้มูล สำนวนกองปราบและเขตพื้นที่&lt;br&gt;รายงานที่ได้รับมอบหมาย&lt;br&gt;คำสั่งคณะกรรมการ&lt;br&gt;คำสั่งคณะกรรมการ [รอยืนยัน DQ2]" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="342.0" y="2275.6" width="876.0" height="158.0" as="geometry"/></mxCell><mxCell id="L0-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.26982;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.49593;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c39" value="รายงานไต่สวนฯ ที่มีประเด็นซับซ้อนยุ่งยาก&lt;br&gt;รายการเรื่องเร่งด่วน [รอยืนยัน DQ4]&lt;br&gt;ผลการสืบค้นรายการไต่สวน" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1682.0" y="667.6" width="876.0" height="120.5" as="geometry"/></mxCell><mxCell id="L0-e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.62602;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.28744;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c10" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c41" value="คำสั่งจ่ายงานให้คณะอนุกรรมการสนับสนุนเลขาธิการฯ&lt;br&gt;ความเห็นประกอบเรื่องเร่งด่วน [รอยืนยัน DQ4]" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1682.0" y="848.1" width="876.0" height="83.0" as="geometry"/></mxCell><mxCell id="L0-e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.48899;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.66120;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c43" value="คำขอเอกสารเพิ่มเติม (ใบบันทึกนำด่วน) กรณีเรื่องเร่งด่วน&lt;br&gt;ผลการสืบค้นรายการไต่สวน&lt;br&gt;รายงานไต่สวนเบื้องต้น สำนวนกองปราบ&lt;br&gt;มติคณะกรรมการ ป.ป.ท. และเอกสารที่เกี่ยวข้อง&lt;br&gt;หนังสือคำสั่งคณะกรรมการ&lt;br&gt;รายงานวินิจฉัยชี้มูล&lt;br&gt;หนังสือลงโทษทางวินัย" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1682.0" y="1015.1" width="876.0" height="270.5" as="geometry"/></mxCell><mxCell id="L0-e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.74863;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.50661;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c11" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c45" value="สำนวนไต่สวนเบื้องต้น/สำนวนไต่สวนวินิจฉัยชี้มูล/เรื่องทั่วไป&lt;br&gt;สำนวนไต่สวนฯ กรณีเร่งด่วน (พร้อมใบบันทึกนำด่วน)" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1682.0" y="1345.6" width="876.0" height="83.0" as="geometry"/></mxCell><mxCell id="L0-e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.62555;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.49462;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c47" value="รายงานไต่สวนเบื้องต้น สำนวนเขตพื้นที่&lt;br&gt;รายงานที่ได้รับมอบหมาย" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=30;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1682.0" y="1512.6" width="876.0" height="83.0" as="geometry"/></mxCell><mxCell id="L0-e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html
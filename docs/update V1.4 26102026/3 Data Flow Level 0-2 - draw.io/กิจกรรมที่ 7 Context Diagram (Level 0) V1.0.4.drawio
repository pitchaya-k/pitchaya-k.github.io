" height="348.0" as="geometry"/></mxCell><mxCell id="L0-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.91575;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.66667;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c38" value="รายงานไต่สวนวินิจฉัยชี้มูล&lt;br&gt;รายงานที่ได้รับมอบหมาย&lt;br&gt;คำสั่งคณะกรรมการ&lt;br&gt;รายงานที่มีมติชี้มูลความผิด" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="352.0" y="2418.3" width="876.0" height="178.0" as="geometry"/></mxCell><mxCell id="L0-e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.19308;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.50376;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c40" value="รายงานไต่สวนที่ซับซ้อน&lt;br&gt;รายการเรื่องเร่งด่วน&lt;br&gt;ผลการสืบค้นรายการไต่สวน" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1692.0" y="461.5" width="876.0" height="135.5" as="geometry"/></mxCell><mxCell id="L0-e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLo
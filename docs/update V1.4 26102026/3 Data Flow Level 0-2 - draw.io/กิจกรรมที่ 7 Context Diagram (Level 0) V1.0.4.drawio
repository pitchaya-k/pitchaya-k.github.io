="1" as="geometry"/></mxCell><mxCell id="L0-c24" value="ผลการลงนามบันทึกกองปราบฯ&lt;br&gt;คำสั่งมอบหมายงาน&lt;br&gt;ผลพิจารณาความซับซ้อนสำนวนชี้มูล&lt;br&gt;ผลการลงนามบรรจุวาระ" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="352.0" y="850.3" width="876.0" height="178.0" as="geometry"/></mxCell><mxCell id="L0-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.38215;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.59880;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c2" target="L0-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c26" value="บันทึกเสนอจากกองปราบฯ&lt;br&gt;รายงานไต่สวน&lt;br&gt;รายการรอลงนามบรรจุวาระ" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=34;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="352.0" y="1088.3" width="876.0" height="135.5" as="geometry"/></mxCell><mxCell id="L0-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.43103;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.51555;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0-c7" target="L0-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L0-c28" value="ระเบียบวาระและหนังสือเชิญประชุม&lt;br&gt;ใบมติและรายงานมติ" style="text;html=1;strokeC
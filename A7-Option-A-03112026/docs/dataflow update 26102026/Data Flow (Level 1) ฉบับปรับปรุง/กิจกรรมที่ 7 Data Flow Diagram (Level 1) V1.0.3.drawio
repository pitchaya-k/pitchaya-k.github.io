=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=0.00000;exitY=0.11858;exitDx=0;exitDy=0;entryX=1.00000;entryY=0.57692;entryDx=0;entryDy=0;" edge="1" parent="1" source="L1-c2" target="L1-c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1-c75" value="คำขอเอกสารเพิ่มเติม (ใบบันทึกนำด่วน) กรณีเรื่องเร่งด่วน&lt;br&gt;ผลการสืบค้นรายการไต่สวน" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=28;whiteSpace=wrap;fontStyle=0;verticalAlign=top;align=left;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="312.0" y="345.6" width="736.0" height="78.0" as="geometry"/></mxCell><mxCell id="L1-e76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;labelBackgroundColor=none;exitX=1.00000;exitY=0.43939;exitDx=0;exitDy=0;entryX=0.00000;entryY=0.35178;entryDx=0;entryDy=0;" edge="1" parent="1" source="L1-c5" target="L1-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1-c77" value="ความเห็น ข้อสั่งการ และผลการลงนามในรายงานไต่สวนฯ&lt;br&gt;คำสั่งส่งกลับสำนวนเร่งด่วนที่ไม่มีใบบันทึกนำด่วน&lt;br&gt;คำสั่งมอบหมายสำนวนที่มีประเด็นซับซ้อนยุ่งยาก" style="text;html=1;strokeColor=none;fillColor=none;rounded=0;fontFamily=TH Sarabun New;fontColor=#000000;spacing=3;fontSize=28;whiteSpace=wrap;fontStyle=0;verticalAlign=bottom;align=right;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="312.0" y="507.6" width="736.0" height="113.0" as="geometry"/></mxCell><mxCell id="L1-e78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=0;fontFamily=TH Sarabun New;fontSize=34;fontColor=#000000;